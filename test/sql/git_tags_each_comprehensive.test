# name: test/sql/git_tags_each_comprehensive.test
# description: Comprehensive tests for git_tags_each LATERAL functionality
# group: [duck_tails]

require duck_tails

statement ok
PRAGMA enable_verification

# Test basic git_tags_each static usage (should be identical to git_tags)
query T
SELECT COUNT(*) >= 0 as valid_tag_count FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo')
----
true

# Test git_tags_each schema consistency (should match git_tags schema)
query I
SELECT COUNT(*) FROM (
  DESCRIBE (SELECT * FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo'))
)
----
7

# Test git_tags_each return columns match expected schema
statement ok
SELECT repo_path, tag_name, commit_hash, tagger_name, is_annotated, tagger_date, message
FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') LIMIT 1

# Test git_tags_each zero-argument version (defaults to current directory)
query T
SELECT COUNT(*) >= 0 as valid_tag_count FROM git_tags_each()
----
true

# Test LATERAL git_tags_each with single repository path
query I
SELECT COUNT(*) >= 0 as valid_count FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo')
----
true

# Test LATERAL git_tags_each column reference validation - confirms dynamic parameter usage
query TTI
WITH test_repos(name, repo_path) AS (
    VALUES ('main-repo', '/tmp/duck_tails_test_fixtures/main-repo'), 
           ('large-repo', '/tmp/duck_tails_test_fixtures/large-repo')
)
SELECT t.name, t.repo_path, 
       (SELECT COUNT(*) FROM git_tags_each(t.repo_path)) >= 0 as valid_count
FROM test_repos t
ORDER BY t.name
----
large-repo	/tmp/duck_tails_test_fixtures/large-repo	true
main-repo	/tmp/duck_tails_test_fixtures/main-repo	true

# Test git_tags_each error handling - non-existent repository
statement error
SELECT * FROM git_tags_each('/path/that/does/not/exist')
----
IO Error: Failed to resolve repository path

# Test LATERAL git_tags_each with NULL repository path (should skip)
query I
SELECT COUNT(*) >= 0 as valid_count FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo')
----
true

# Test git_tags_each with named parameters
query T
SELECT COUNT(*) >= 0 as valid_tag_count FROM git_tags_each(repo_path := '/tmp/duck_tails_test_fixtures/main-repo')
----
true

# Test git_tags_each functional equivalence with git_tags (should be identical)
query I
SELECT 
    (SELECT COUNT(*) FROM git_tags('/tmp/duck_tails_test_fixtures/main-repo')) > 0 AND
    (SELECT COUNT(*) FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo')) > 0 as both_have_results
----
true

# Test LATERAL git_tags_each in cross-repository analysis
statement ok
SELECT p.name, tags.tag_name, LENGTH(tags.commit_hash) = 40 as valid_hash
FROM (VALUES ('main', '/tmp/duck_tails_test_fixtures/main-repo')) p(name, path), 
     LATERAL git_tags_each(p.path) tags
LIMIT 3

# Test git_tags_each repo_path column consistency
statement ok
SELECT DISTINCT repo_path FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') LIMIT 1

# Test git_tags_each tag name format (when tags exist)
statement ok
SELECT tag_name, commit_hash, tagger_name 
FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') 
WHERE tag_name IS NOT NULL AND LENGTH(tag_name) > 0
LIMIT 5

# Test git_tags_each commit hash validation (when tags exist)
statement ok
SELECT tag_name 
FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') 
WHERE commit_hash IS NOT NULL AND LENGTH(commit_hash) = 40
LIMIT 5

# Test LATERAL git_tags_each with conditional processing
query I
SELECT COUNT(*) >= 0 as valid_count
FROM (VALUES ('/tmp/duck_tails_test_fixtures/main-repo')) t(repo_path),
     LATERAL git_tags_each(t.repo_path) tags
----
true

# Test git_tags_each performance with generate_series
query II
SELECT g.i, COUNT(*) >= 0 as valid_count
FROM generate_series(1, 2) g(i),
     LATERAL git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') tags
GROUP BY g.i
ORDER BY g.i
----
1	true
2	true

# Test git_tags_each date handling (when tags exist)
statement ok
SELECT tag_name, tagger_date
FROM git_tags_each('/tmp/duck_tails_test_fixtures/main-repo')
WHERE tagger_date IS NOT NULL
LIMIT 3