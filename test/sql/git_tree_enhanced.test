# name: test/sql/git_tree_enhanced.test
# description: Test enhanced git_tree function with LATERAL support and multiple modes
# group: [duck_tails]

require duck_tails

statement ok
PRAGMA enable_verification

# Test single commit mode (backwards compatibility) - check structure not exact values
query I
SELECT COUNT(*) FROM git_tree('HEAD') WHERE path LIKE '.%' AND mode > 0 AND length(blob_hash) = 40 AND size > 0
----
6

# Test zero argument version (defaults) - check structure consistency
query I
SELECT COUNT(*) FROM git_tree() WHERE path LIKE '.%' AND mode > 0 AND length(blob_hash) = 40 AND size > 0
----
6

# Verify schema has 6 columns as expected
query I
SELECT COUNT(*) FROM (
  DESCRIBE (SELECT * FROM git_tree('HEAD'))
)
----
6

# Test that commit_hash and commit_date are properly populated
query I
SELECT COUNT(DISTINCT commit_hash) FROM git_tree('HEAD')
----
1

# Test LATERAL join with dynamic commit (single commit from git_log)
# Note: Currently expect this to fail - LATERAL support requires additional implementation
statement error
SELECT COUNT(*) 
FROM git_log() l 
JOIN LATERAL git_tree(l.commit_hash) t ON TRUE 
WHERE l.commit_hash = (SELECT commit_hash FROM git_log() LIMIT 1)
----
Table function "git_tree" does not support lateral join column parameters

# Test array mode with multiple commits - SUCCESS! 
query I
SELECT COUNT(DISTINCT commit_hash) 
FROM git_tree(ARRAY['HEAD', 'HEAD~1'])
----
2