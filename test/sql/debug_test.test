# Test 6b: git_read_each with LATERAL
query II
SELECT 
    t.file_path,
    LENGTH(r.text) > 0 as has_content
FROM git_tree_each(CONCAT('git://', FIXTURE_PATH(), '@HEAD')) t
CROSS JOIN LATERAL (
    SELECT text 
    FROM git_read_each(t.git_uri)
) r
WHERE t.file_path = 'README.md';
----
README.md	true

