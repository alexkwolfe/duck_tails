# name: test/sql/git_each_integration.test
# description: Integration tests for all git_*_each LATERAL functions working together
# group: [duck_tails]

require duck_tails

statement ok
PRAGMA enable_verification

# Test git_uri helper function integration with git_tree git_file_uri
query T
SELECT git_file_uri = git_uri('/tmp/duck_tails_test_fixtures/main-repo', path, commit_hash) as uri_matches
FROM git_tree('HEAD', '/tmp/duck_tails_test_fixtures/main-repo') 
WHERE path = 'README.md'
----
true

# Test seamless integration: git_tree -> git_file_uri -> git_read_each
statement ok
SELECT t.path, LENGTH(r.text) > 0 as has_content
FROM git_tree('HEAD', '/tmp/duck_tails_test_fixtures/main-repo') t, LATERAL git_read_each(t.git_file_uri) r
WHERE t.path = 'README.md'

# Test multi-repository LATERAL analysis with git_branches_each
query TTI
WITH repos(name, path) AS (VALUES ('main-repo', '/tmp/duck_tails_test_fixtures/main-repo'))
SELECT r.name, b.branch_name, COUNT(*) as commit_count
FROM repos r,
     LATERAL git_branches_each(r.path) b,
     LATERAL git_log_each(r.path) l
WHERE b.branch_name IS NOT NULL
GROUP BY r.name, b.branch_name
LIMIT 3
----

# Test cross-function integration: git_log_each -> git_tree_each
query TII
SELECT l.commit_hash, COUNT(*) as file_count, COUNT(DISTINCT t.path) as unique_files
FROM git_log_each('/tmp/duck_tails_test_fixtures/main-repo') l,
     LATERAL git_tree_each(l.commit_hash) t
GROUP BY l.commit_hash
LIMIT 2
----

# Test git_uri construction with dynamic parameters from git_log_each
query TT
SELECT l.commit_hash, git_uri(l.repo_path, 'README.md', l.commit_hash) as constructed_uri
FROM git_log_each('/tmp/duck_tails_test_fixtures/main-repo') l
LIMIT 2
----

# Test comprehensive repository analysis pipeline
query TTII
WITH analysis AS (
    SELECT 
        l.repo_path,
        l.commit_hash,
        COUNT(DISTINCT t.path) as files_in_commit,
        COUNT(DISTINCT b.branch_name) as branches_count
    FROM git_log_each('/tmp/duck_tails_test_fixtures/main-repo') l
    LEFT JOIN LATERAL git_tree_each(l.commit_hash) t ON true
    LEFT JOIN LATERAL git_branches_each(l.repo_path) b ON true
    GROUP BY l.repo_path, l.commit_hash
)
SELECT repo_path, commit_hash, files_in_commit, branches_count
FROM analysis
WHERE files_in_commit > 0
LIMIT 2
----

# Test all _each functions have LATERAL capability
statement ok
WITH test_data(repo_path) AS (VALUES ('/tmp/duck_tails_test_fixtures/main-repo'))
SELECT 'git_log_each' as func FROM test_data t, LATERAL git_log_each(t.repo_path) l LIMIT 1
UNION ALL
SELECT 'git_tree_each' as func FROM test_data t, LATERAL git_tree_each('HEAD') tr LIMIT 1
UNION ALL  
SELECT 'git_branches_each' as func FROM test_data t, LATERAL git_branches_each(t.repo_path) b LIMIT 1
UNION ALL
SELECT 'git_tags_each' as func FROM test_data t, LATERAL git_tags_each(t.repo_path) tag LIMIT 1

# Test schema consistency across all _each functions
query IIIII
SELECT 
    (SELECT COUNT(*) FROM (DESCRIBE git_log_each('/tmp/duck_tails_test_fixtures/main-repo'))) as log_cols,
    (SELECT COUNT(*) FROM (DESCRIBE git_tree_each('HEAD'))) as tree_cols,  
    (SELECT COUNT(*) FROM (DESCRIBE git_branches_each('/tmp/duck_tails_test_fixtures/main-repo'))) as branch_cols,
    (SELECT COUNT(*) FROM (DESCRIBE git_tags_each('/tmp/duck_tails_test_fixtures/main-repo'))) as tag_cols,
    (SELECT COUNT(*) FROM (DESCRIBE git_uri('/tmp/duck_tails_test_fixtures/main-repo', 'file', 'HEAD'))) as uri_cols
----
6	7	4	7	1

# Test performance: all _each functions handle multiple inputs efficiently
query I
SELECT COUNT(*) as total_results FROM (
    SELECT 'log' as type FROM generate_series(1,3) g, LATERAL git_log_each('/tmp/duck_tails_test_fixtures/main-repo') l
    UNION ALL
    SELECT 'tree' as type FROM generate_series(1,3) g, LATERAL git_tree_each('HEAD') t  
    UNION ALL
    SELECT 'branches' as type FROM generate_series(1,3) g, LATERAL git_branches_each('/tmp/duck_tails_test_fixtures/main-repo') b
    UNION ALL
    SELECT 'tags' as type FROM generate_series(1,3) g, LATERAL git_tags_each('/tmp/duck_tails_test_fixtures/main-repo') tag
)
----

