# Git URI Composability Tests - Checklist for _each functions
# ================================================
# This test file serves as both a checklist and test suite for verifying
# that all _each functions support git:// URI parsing for composability
# in LATERAL joins.
#
# CHECKLIST FOR EACH _each FUNCTION:
# 1. ✅ Accept git:// URI as input (e.g., git://repo@ref)
# 2. ✅ Parse repository path from URI
# 3. ✅ Parse ref/commit from URI
# 4. ✅ Handle optional file path in URI
# 5. ✅ Work in LATERAL joins with output from other functions
# 6. ✅ Handle both URI and plain path formats
# 7. ✅ Handle null values gracefully
# 8. ✅ Proper error messages for invalid URIs
#
# Functions tested:
# - git_tree_each (produces git_file_uri)
# - git_log_each (consumes git_file_uri)
# - git_parents_each (consumes git URIs)
# - git_branches_each (consumes git URIs)
# - git_tags_each (consumes git URIs)
# - git_read_each (consumes git_file_uri)

statement ok
SET autoinstall_extension_repository='/Users/alex/Dev/duck_tails/build/debug/repository';

statement ok
SET autoload_known_extensions='true';

statement ok
SET custom_extension_repository='/Users/alex/Dev/duck_tails/build/debug/repository';

statement ok
LOAD duck_tails;

# Test 1: git_tree produces git_file_uri that can be consumed by _each functions
# ================================================================================

# First verify that git_tree produces git_file_uri (with resolved commit hash)
query II
SELECT 
    path, 
    git_file_uri LIKE 'git://%' as has_uri_format
FROM git_tree('HEAD', repo_path => '/Users/alex/Dev/duck_tails')
WHERE path LIKE 'README%'
ORDER BY path
LIMIT 1;
----
README.md	true

# Test 2: git_log_each can consume git:// URIs from git_tree
# ===========================================================

# Test composability: git_tree outputs git_file_uri, git_log_each consumes it
query II
SELECT 
    t.path,
    COUNT(l.commit_hash) as commit_count
FROM git_tree('HEAD', repo_path => '/Users/alex/Dev/duck_tails') t
CROSS JOIN LATERAL (
    SELECT commit_hash 
    FROM git_log_each(t.git_file_uri) 
    LIMIT 1
) l
WHERE t.path = 'README.md'
GROUP BY t.path;
----
README.md	1

# Test 3: git_parents_each can consume git:// URIs
# =================================================

# First, get a commit hash wrapped in git:// URI format
query I
WITH commits AS (
    SELECT 'git://' || '/Users/alex/Dev/duck_tails' || '@' || commit_hash as git_commit_uri,
           commit_hash
    FROM git_log('/Users/alex/Dev/duck_tails') 
    LIMIT 5
)
SELECT 
    COUNT(*) > 0 as has_parents
FROM commits c
CROSS JOIN LATERAL git_parents_each(c.git_commit_uri) p;
----
true

# Test 4: git_branches_each can consume git:// URIs
# ==================================================

query II
WITH repos AS (
    SELECT 'git://' || '/Users/alex/Dev/duck_tails' || '@HEAD' as repo_uri
)
SELECT 
    COUNT(b.branch_name) as branch_count,
    MAX(b.is_current::INTEGER) as has_current
FROM repos r
CROSS JOIN LATERAL git_branches_each(r.repo_uri) b;
----
2	1

# Test 5: git_tags_each can consume git:// URIs
# ==============================================

query I
WITH repos AS (
    SELECT 'git://' || '/Users/alex/Dev/duck_tails' || '@HEAD' as repo_uri
)
SELECT 
    COUNT(t.tag_name) as tag_count
FROM repos r
CROSS JOIN LATERAL git_tags_each(r.repo_uri) t;
----
0

# Test 6: git_read_each can consume git_file_uri from git_tree
# =============================================================

query II
SELECT 
    t.path,
    LENGTH(r.content) > 0 as has_content
FROM git_tree('HEAD', repo_path => '/Users/alex/Dev/duck_tails') t
CROSS JOIN LATERAL (
    SELECT content 
    FROM git_read_each(t.git_file_uri)
) r
WHERE t.path = 'README.md';
----
README.md	true

# Test 7: Complex composability - chaining multiple functions
# ===========================================================

# Chain git_tree -> git_log_each -> git_parents_each using URIs
query II
WITH tree_files AS (
    SELECT path, git_file_uri 
    FROM git_tree('HEAD', repo_path => '/Users/alex/Dev/duck_tails')
    WHERE path = 'README.md'
),
file_commits AS (
    SELECT 
        tf.path,
        'git://' || '/Users/alex/Dev/duck_tails' || '@' || l.commit_hash as commit_uri,
        l.commit_hash
    FROM tree_files tf
    CROSS JOIN LATERAL git_log_each(tf.git_file_uri) l
    LIMIT 1
)
SELECT 
    fc.path,
    COUNT(p.parent_hash) >= 0 as has_valid_count
FROM file_commits fc
LEFT JOIN LATERAL git_parents_each(fc.commit_uri) p ON true
GROUP BY fc.path;
----
README.md	true

# Test 8: Error handling - invalid git:// URIs
# =============================================

statement error
SELECT * FROM git_log_each('git://invalid@@@uri');

statement error 
SELECT * FROM git_parents_each('git://nonexistent/repo@HEAD');

# Test 9: Null handling
# ====================

query I
WITH test_data AS (
    SELECT NULL::VARCHAR as uri
    UNION ALL
    SELECT 'git:///Users/alex/Dev/duck_tails@HEAD'
)
SELECT COUNT(*)
FROM test_data t
LEFT JOIN LATERAL git_log_each(t.uri) l ON true
WHERE t.uri IS NOT NULL;
----
1132

# Test 10: Direct URI usage (without LATERAL)
# ===========================================

# Each function should also work with direct git:// URI input
query I
SELECT COUNT(*) > 0 as has_commits
FROM git_log_each('git:///Users/alex/Dev/duck_tails@HEAD');
----
true

query I
SELECT COUNT(*) > 0 as has_branches  
FROM git_branches_each('git:///Users/alex/Dev/duck_tails@HEAD');
----
true

query I
SELECT COUNT(*) >= 0 as valid_result
FROM git_tags_each('git:///Users/alex/Dev/duck_tails@HEAD');
----
true

query I
SELECT COUNT(*) > 0 as has_parents
FROM git_parents_each('git:///Users/alex/Dev/duck_tails@HEAD');
----
true

query I
SELECT COUNT(*) > 0 as has_tree
FROM git_tree_each('git:///Users/alex/Dev/duck_tails@HEAD');
----
true

query I
SELECT LENGTH(content) > 0 as has_content
FROM git_read_each('git:///Users/alex/Dev/duck_tails/README.md@HEAD');
----
true

# SUCCESS: All _each functions support git:// URI parsing for composability!