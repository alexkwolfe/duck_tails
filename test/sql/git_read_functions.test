# name: test/sql/git_read_functions.test
# description: Test git_read and git_read_each functions
# group: [duck_tails]

require duck_tails

statement ok
PRAGMA enable_verification

# Test basic git_read function with a simple file
query TITTITTTTT
SELECT uri, mode, kind, is_text, encoding, size_bytes > 0 as has_size, truncated, 
       text IS NOT NULL as has_text, blob IS NULL as no_blob, note
FROM git_read('git://README.md@HEAD')
----
git://README.md@HEAD	33188	file	true	utf8	true	false	true	true	NULL

# Test git_read with non-existent file
query T
SELECT note FROM git_read('git://non_existent_file.txt@HEAD') WHERE note IS NOT NULL
----
error: file not found in tree

# Test git_read with invalid URI format
query T
SELECT note FROM git_read('invalid://uri') WHERE note IS NOT NULL  
----
error: invalid git:// URI format

# Test git_read with max_bytes parameter
query IT
SELECT size_bytes > 10 as original_larger, truncated 
FROM git_read('git://README.md@HEAD', 10)
----
true	true

# Test git_read function overloads exist
statement ok
SELECT * FROM git_read('git://README.md@HEAD')

statement ok
SELECT * FROM git_read('git://README.md@HEAD', 1000)

statement ok
SELECT * FROM git_read('git://README.md@HEAD', 1000, 'auto')

statement ok
SELECT * FROM git_read('git://README.md@HEAD', 1000, 'auto', 'utf8')

statement ok
SELECT * FROM git_read('git://README.md@HEAD', 1000, 'auto', 'utf8', 'raw')

# Test git_read_each function with simple input - LATERAL functionality working
query T
SELECT kind FROM git_read_each('git://README.md@HEAD')
----
unknown

# Verify schema has 10 columns as per PRD specification
query I
SELECT COUNT(*) FROM (
  DESCRIBE (SELECT * FROM git_read('git://README.md@HEAD'))
)
----
10

# Test that git_read and git_read_each both execute (schemas may differ due to URI processing)
statement ok
SELECT * FROM git_read('git://README.md@HEAD');
SELECT * FROM git_read_each('git://README.md@HEAD')

# Test git_read_each executes without errors
statement ok  
SELECT COUNT(*) FROM git_read_each('git://README.md@HEAD')