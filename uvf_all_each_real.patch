+// --- UVF helpers for reading VARCHAR inputs in *_each functions ---
+// Returns true and sets 'out' when column exists and value is non-NULL at 'row'.
+// Returns false if column is out-of-bounds or the specific row is NULL.
+static inline bool TryReadVarcharAtRow(const DataChunk &input, idx_t col, idx_t row, std::string &out) {
+    if (col >= input.ColumnCount()) {
+        return false;
+    }
+    UnifiedVectorFormat fmt;
+    input.data[col].ToUnifiedFormat(input.size(), fmt);
+    const auto *vals = UnifiedVectorFormat::GetData<string_t>(fmt);
+    const auto idx = fmt.sel->get_index(row);
+    if (!fmt.validity.RowIsValid(idx)) {
+        return false;
+    }
+    out = vals[idx].GetString();
+    return true;
+}
+
+// Same as TryReadVarcharAtRow, but throws if the value is missing.
+static inline std::string ReadRequiredVarcharAtRow(const DataChunk &input, idx_t col, idx_t row, const char *what) {
+    std::string out;
+    if (!TryReadVarcharAtRow(input, col, row, out)) {
+        throw BinderException(StringUtil::Format("%s: NULL or missing argument at column %llu (row %llu)",
+                                                 what ? what : "required argument",
+                                                 (unsigned long long)col, (unsigned long long)row));
+    }
+    return out;
+}
