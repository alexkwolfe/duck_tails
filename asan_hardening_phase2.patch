             output.SetValue(4,  out_count, Value(r.file_path));
             output.SetValue(5,  out_count, Value(r.file_ext));
             output.SetValue(6,  out_count, Value(r.ref));
             output.SetValue(7,  out_count, Value(r.blob_hash));
             output.SetValue(8,  out_count, Value::INTEGER(r.mode));
             output.SetValue(9,  out_count, Value(r.kind));
             output.SetValue(10, out_count, Value::BOOLEAN(r.is_text));
             output.SetValue(11, out_count, Value(r.encoding));
             output.SetValue(12, out_count, Value::BIGINT(r.size_bytes));
             output.SetValue(13, out_count, Value::BOOLEAN(r.truncated));

-            if (!r.text.empty()) {
-                output.SetValue(14, out_count, Value(r.text));
-            } else {
-                FlatVector::SetNull(output.data[14], out_count, true);
-            }
+            if (!r.text.empty()) { output.SetValue(14, out_count, Value(r.text)); }
+            else { FlatVector::SetNull(output.data[14], out_count, true); }

-            // BLOB: use SetValue for safety across vector types
-            if (!r.blob.empty()) {
-                auto &col = output.data[15];
-                FlatVector::GetData<string_t>(col)[out_count] =
-                    StringVector::AddStringOrBlob(col, r.blob);
-                FlatVector::SetNull(col, out_count, false);
-            } else {
-                FlatVector::SetNull(output.data[15], out_count, true);
-            }
+            // BLOB via SetValue (future-proof against non-flat vectors)
+            if (!r.blob.empty()) { output.SetValue(15, out_count, Value::BLOB_RAW(r.blob)); }
+            else { FlatVector::SetNull(output.data[15], out_count, true); }

             out_count++;
             state.current_output_row++;
         }

         output.SetCardinality(out_count);

         if (state.current_output_row >= state.current_results.size()) {
             state.current_input_row++;
             state.initialized_row = false;
         }

         if (out_count > 0) {
             return OperatorResultType::HAVE_MORE_OUTPUT;
         }
     }
 }


# ----------------------------------------------------
# Patch 4: Scalar UDF `git_uri` — force FLAT result in general path
# ----------------------------------------------------
diff --git a/src/git_functions.cpp b/src/git_functions.cpp
--- a/src/git_functions.cpp
+++ b/src/git_functions.cpp
@@ -AAAA,20 +AAAA,26 @@
 static void GitUriFunction(DataChunk &args, ExpressionState &state, Vector &result) {
     // fast-path: if all inputs are constant, you already set CONSTANT and write a single slot, then return
     if (args.AllConstant()) {
         // existing constant path — keep as-is
         return;
     }

-    // general path (non-constant and/or dictionary inputs)
+    // general path (non-constant and/or dictionary inputs):
+    // force result to FLAT before per-row writes
+    result.SetVectorType(VectorType::FLAT_VECTOR);

     UnifiedVectorFormat repo_fmt, file_fmt, ref_fmt;
     args.data[0].ToUnifiedFormat(args.size(), repo_fmt);
     args.data[1].ToUnifiedFormat(args.size(), file_fmt);
     args.data[2].ToUnifiedFormat(args.size(), ref_fmt);

     auto repo = UnifiedVectorFormat::GetData<string_t>(repo_fmt);
     auto file = UnifiedVectorFormat::GetData<string_t>(file_fmt);
     auto ref  = UnifiedVectorFormat::GetData<string_t>(ref_fmt);

     auto out = FlatVector::GetData<string_t>(result);
     for (idx_t i = 0; i < args.size(); i++) {
         const auto ri = repo_fmt.sel->get_index(i);
         const auto fi = file_fmt.sel->get_index(i);
         const auto ci = ref_fmt.sel->get_index(i);

         if (!repo_fmt.validity.RowIsValid(ri) ||
             !file_fmt.validity.RowIsValid(fi) ||
             !ref_fmt.validity.RowIsValid(ci)) {
             FlatVector::SetNull(result, i, true);
             continue;
         }

         const auto uri = BuildGitURI(repo[ri].GetString(), file[fi].GetString(), ref[ci].GetString());
         out[i] = StringVector::AddString(result, uri);
     }
 }


