             // Canonicalize URI
             string uri;
             if (StringUtil::StartsWith(first_param, "git://")) {
                 uri = explicit_ref.empty() ? first_param : first_param + "@" + explicit_ref;
             } else {
                 const string &ref = explicit_ref.empty() ? string("HEAD") : explicit_ref;
