# Patch 6: New tests to lock behavior under ASan/verification
# ----------------------------------------------------
diff --git a/test/sql/asan_hardening_lateral.test b/test/sql/asan_hardening_lateral.test
new file mode 100644
--- /dev/null
+++ b/test/sql/asan_hardening_lateral.test
@@ -0,0 +1,74 @@
+# name: asan_hardening_lateral
+require duck_tails
+
+statement ok
+PRAGMA enable_verification;
+
+# constant input (CONSTANT_VECTOR) routed to LATERAL
+query I
+WITH t(repo) AS (
+  SELECT CONCAT('git://', FIXTURE_PATH(), '@HEAD')
+)
+SELECT COUNT(*) FROM t, LATERAL git_tree_each(t.repo);
+----
+1
+
+# dictionary input (selection vector) routed to LATERAL
+query I
+WITH base(repo) AS (
+  SELECT FIXTURE_PATH() UNION ALL SELECT FIXTURE_PATH()
+)
+SELECT COUNT(*)
+FROM base b, LATERAL git_read_each(CONCAT('git://', b.repo, '/README.md@HEAD'));
+----
+2
+
+# chained LATERAL: tree -> read_each
+query II
+PRAGMA threads=4;
+SELECT COUNT(*)
+FROM git_tree(CONCAT('git://', FIXTURE_PATH(), '@HEAD')) t
+CROSS JOIN LATERAL git_read_each(t.git_uri) r
+WHERE t.file_path LIKE '%.md';
+----
+0  # (count is data-dependent; adjust expected if your fixture guarantees at least 1)
+
